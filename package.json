{
  "name": "@nalanchujian/aiw",
  "version": "0.0.6",
  "description": "可信、可控、可追责的 AI 研发工作流 CLI。",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nalanchujian/ai-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/nalanchujian/ai-workflow/issues"
  },
  "homepage": "https://github.com/nalanchujian/ai-workflow#readme",
  "keywords": [
    "ai",
    "agent",
    "workflow",
    "codex",
    "cli"
  ],
  "engines": {
    "node": ">=22.0.0 <23.0.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "bin": {
    "aiw": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc --project tsconfig.build.json && node scripts/make-cli-executable.mjs",
    "dev": "tsx src/cli.ts",
    "link:global": "pnpm build && pnpm link --global",
    "lint": "eslint .",
    "pack:check": "pnpm build && npm pack --dry-run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "publish:public": "node scripts/assert-release-ready.mjs && npm publish --access public --registry=https://registry.npmjs.org && node scripts/commit-published-package.mjs",
    "release:patch": "node scripts/assert-release-clean.mjs && pnpm version patch --no-git-tag-version && pnpm publish:public",
    "typecheck": "tsc --noEmit",
    "unlink:global": "pnpm unlink --global",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  }
}
